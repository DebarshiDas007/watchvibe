/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://image.tmdb.org https://images.unsplash.com https://ui-avatars.com https://*.supabase.co https://*.googleusercontent.com https://cdn.discordapp.com; connect-src 'self' https://image.tmdb.org https://images.unsplash.com https://api.themoviedb.org https://*.supabase.co wss://*.supabase.co https://ipapi.co https://api.country.is; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/sw.js
  Cache-Control: no-cache

/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/swiss.css
  Cache-Control: public, max-age=31536000, immutable

/theme.css
  Cache-Control: public, max-age=31536000, immutable

/games.js
  Cache-Control: public, max-age=31536000, immutable

/hover-card.css
  Cache-Control: public, max-age=31536000, immutable

/catalog_extra.json
  Cache-Control: public, max-age=31536000, immutable
